# Copy to .env (git-ignored) and fill in. Nothing here is required: without a key the service runs
# in an explicit DEMO mode (deterministic templates, no model calls).

# --- data (organizers' files, see README "Data"); defaults shown
DATA_DIR=data/handout
# RULES_PATH=data/handout/rules.json
# TAXONOMY_PATH=data/handout/taxonomy.json
DB_PATH=data/local/copilot.db
# optional sourced answers for recurring game questions (see app/faq.py); absent = such questions go to a human
# FAQ_PATH=data/kb/faq.json
# learned complaint classifier built by `make train` (absent = lexicon only); USE_MODEL=0 switches it off
# MODEL_PATH=data/models/complaint_clf.joblib
USE_MODEL=1

# --- optional LLM drafting (Anthropic Messages API). Claude.ai Pro/Max subscriptions do NOT include API access:
# create an API key at https://platform.claude.com/ (separate billing).
ANTHROPIC_API_KEY=
# or Google Gemini (https://aistudio.google.com -> Get API key). The FREE tier may use the submitted text to improve Google's products:
# use it only with artificial demo tickets; real player tickets need a paid tier (or no LLM). With both keys set, LLM_PROVIDER decides.
GEMINI_API_KEY=
# 0 keeps a key configured but switches the model off. The evaluation scripts on real tickets always force 0; keep 0 while a FREE tier key
# is set, so that `make predict` on real tickets never sends player text to it (data terms).
LLM_ENABLED=1
# LLM_PROVIDER=gemini
# empty = the provider's default: claude-haiku-5-5 / gemini-3.5-flash-lite
LLM_MODEL=
LLM_TIMEOUT_S=3.5
# wall-clock budget for the model call of ONE ticket (the p95 target for the whole ticket is 5 s); a retry needs >= 0.8 s left
LLM_TOTAL_BUDGET_S=4.0
LLM_MAX_OUTPUT_TOKENS=450
# Haiku 5.5: no temperature/top_p/top_k are sent (the API says to omit them); adaptive thinking is switched off and effort kept low
LLM_EFFORT=low
LLM_DISABLE_THINKING=1
# USD per million tokens, copied by hand from https://platform.claude.com/docs/en/about-claude/pricing
# (Haiku 5.5, prompts <= 100k tokens, checked 2026-10-30: input 0.10, output 0.50). Left 0 => cost reported as "unknown".
# For Gemini set the prices of YOUR model from https://ai.google.dev/pricing (the values below are Anthropic's, not Gemini's).
LLM_PRICE_IN_PER_MTOK=0.10
LLM_PRICE_OUT_PER_MTOK=0.50
# worst-case cost ceiling for ONE ticket; enforced only when both prices above are set (it lowers max_tokens or skips the call)
LLM_BUDGET_PER_TICKET_USD=0.002

# --- output conventions that the organizers have not confirmed yet (see docs/LIMITATIONS.md, rows 10-11)
# Kazakh drafts with the game's cp1251 look-alike letters (ќ ґ ѕ є ј ў ї) instead of normal Kazakh
KK_OUTPUT_GAME_SYMBOLS=0
# top-level `lang` limited to the PDF contract values ru|kk|uz|en|und (lat->ru, es/pt->und)
LANG_STRICT_CONTRACT=0

# --- access control (app/security.py): roles service (POST /triage), viewer (read), admin (everything); tokens >= 16 characters.
# EMPTY = authentication OFF (demo mode, reported by /health). Set it before exposing the service.
# empty = explicit DEMO mode (authentication off). If set, it must be fully valid: an unknown role or a token shorter than 16 characters
# STOPS the start-up (a typo never turns authentication off silently).
API_TOKENS=
# requests per minute per VERIFIED token or per IP on /triage and /api/* (a batch counts each ticket); per process.
# Unset: 0 (off) in the demo mode, 1200 when API_TOKENS is set. An invented Authorization header never gets its own counter.
# RATE_LIMIT_PER_MIN=1200
# needs_human confidence thresholds
HUMAN_CONF_MIN=0.4
HUMAN_AMBIGUOUS_MIN=0.5

# --- store every POST /triage in the admin queue (off by default)
PERSIST_TRIAGE=0

# duplicate-detection history of the HTTP service survives a restart (kept in the same SQLite file; batch mode never persists it)
DEDUP_PERSIST=1

# --- optional Telegram demo bot (off by default)
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
